{
  "name": "brainrot-rush",
  "tree": {
    "$className": "DataModel",
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true,
        "RespawnTime": 3
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "BuyBrainrot": { "$className": "RemoteFunction" },
        "Rebirth": { "$className": "RemoteFunction" },
        "BuyLock": { "$className": "RemoteFunction" },
        "StateChanged": { "$className": "RemoteEvent" },
        "Notify": { "$className": "RemoteEvent" },
        "WaveAlert": { "$className": "RemoteEvent" },
        "OpenShop": { "$className": "RemoteEvent" }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 90,
        "CameraMinZoomDistance": 9,
        "CharacterWalkSpeed": 24,
        "CharacterJumpPower": 48,
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "Gravity": 150
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [0.36, 0.33, 0.42],
        "OutdoorAmbient": [0.48, 0.46, 0.54],
        "Brightness": 2.4,
        "ClockTime": 14.5,
        "GlobalShadows": true,
        "Outlines": false,
        "EnvironmentDiffuseScale": 0.4,
        "EnvironmentSpecularScale": 0.5,
        "Technology": "ShadowMap"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true,
        "AmbientReverb": "Plain"
      }
    }
  }
}
